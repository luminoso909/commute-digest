# 照此配置当前进程的环境，或在 Linux 上填入 systemd EnvironmentFile。
# 供共享早晚报使用。个人模型密钥在网页「API 设置」中填写。
DEEPSEEK_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECIPIENT_EMAIL=
PUBLIC_BASE_URL=
# AutoDL 使用 ngrok 时填写。已有 .autodl/ngrok.yml 的部署可沿用其令牌。
# NGROK_AUTHTOKEN=
# COMMUTE_DB=/var/lib/commute-digest/morning.sqlite3
