# 照此配置当前进程的环境，或在 Linux 上填入 systemd EnvironmentFile。
# 供共享早晚报使用。个人模型密钥在网页「API 设置」中填写。
DEEPSEEK_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 默认发件地址。SMTP_USER 已是邮箱时可复用；登录名不是邮箱时请单独填写。
SMTP_FROM=
# 仅用于系统共享日报。个人订阅和调试投递使用读者在网页设置的邮箱。
RECIPIENT_EMAIL=
PUBLIC_BASE_URL=
# 设为 1 后，登录读者可在侧栏点击「调试投递」，立即生成并发送个人日报。
COMMUTE_DEBUG_DELIVERY=0
# AutoDL 使用 ngrok 时填写。已有 .autodl/ngrok.yml 的部署可沿用其令牌。
# NGROK_AUTHTOKEN=
# COMMUTE_DB=/var/lib/commute-digest/morning.sqlite3
